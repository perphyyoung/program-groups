{
  "name": "program-groups",
  "version": "0.1.1",
  "private": true,
  "description": "Windows 已安装软件整理与分组工具",
  "author": "perphyyoung",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test",
    "type-check": "vue-tsc --noEmit",
    "format": "oxfmt src electron e2e electron.vite.config.ts playwright.config.ts vitest.config.mts eslint.config.mjs package.json",
    "lint:oxlint": "oxlint src electron e2e electron.vite.config.ts playwright.config.ts vitest.config.mts",
    "lint:eslint": "eslint \"src/**/*.{vue,html}\"",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:fix": "oxlint --fix src electron e2e electron.vite.config.ts playwright.config.ts vitest.config.mts && eslint --fix \"src/**/*.{vue,html}\"",
    "check": "pnpm format && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "fix": "pnpm format && pnpm lint:fix",
    "release": "pnpm build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --publish never"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@html-eslint/parser": "^0.67.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.12.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-vue": "^10.12.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.18.0",
  "build": {
    "appId": "com.program-groups.perphyyoung",
    "productName": "Program Groups",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
